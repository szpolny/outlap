{
	"name": "outlap",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.9.0",
	"scripts": {
		"dev": "pnpm --filter @szpolny/calendar-kit build && vite dev",
		"build": "pnpm --filter @szpolny/calendar-kit build && vite build",
		"preview": "vite preview",
		"prepare": "pnpm --filter @szpolny/calendar-kit build && svelte-kit sync",
		"check": "pnpm --filter @szpolny/calendar-kit build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm --filter @szpolny/calendar-kit build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "pnpm --filter @szpolny/calendar-kit build && node --test tests/*.test.js"
	},
	"devDependencies": {
		"@fontsource-variable/saira": "^5.3.0",
		"@iconify-json/lucide": "^1.2.142",
		"@iconify-json/simple-icons": "^1.2.99",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"flag-icons": "^7.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"wrangler": "^4.149.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@szpolny/calendar-kit": "workspace:*"
	}
}
